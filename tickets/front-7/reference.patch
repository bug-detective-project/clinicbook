+/* The two tabs of the record, as one control. */
+.tabs {
+  display: inline-flex;
+  gap: 4px;
+  margin-bottom: 20px;
+  padding: 4px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: var(--surface);
+}
+
+.tabs a {
+  padding: 8px 16px;
+  border-radius: 9px;
+  color: var(--muted);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.tabs a:hover {
+  background: var(--sunken);
+  color: var(--ink);
+}
+
+.tabs a[aria-current='page'] {
+  background: var(--brand);
+  color: var(--brand-ink);
+}
