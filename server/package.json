{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:reset": "node src/scripts/reset-db.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "kysely": "0.29.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
